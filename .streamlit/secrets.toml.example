# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local testing,
# or paste these key-value pairs into the Streamlit Community Cloud / Hugging Face Secrets Manager.
# NEVER commit your real secrets.toml or API keys to git.

# 1. Generative AI Writing Coach (Gemini)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash"

# 2. Web Search API Keys (At least one recommended for live web search)
TAVILY_API_KEY = "your_tavily_api_key_here"
BRAVE_API_KEY = "your_brave_api_key_here"

# 3. Translation Key (Optional: Google Cloud Translation; free fallback translator used otherwise)
GOOGLE_TRANSLATE_API_KEY = "your_google_cloud_translate_key_here"

# 4. Access Protection & Quota Control (Optional)
# Set APP_PASSWORD to require users to enter a password before accessing the application.
APP_PASSWORD = ""

# Maximum number of document scans allowed per browser session (default: 10)
MAX_CHECKS_PER_SESSION = 10

# 5. Low Memory Mode (Recommended for Streamlit Cloud 1GB RAM tier)
LOW_MEMORY_MODE = "true"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
