# PlagiarismAI Environment Configuration
# Copy this file to .env and supply your API keys.

# Web Search Providers (Optional: Tavily or Brave for live web crawling)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Cloud AI Translation API (Google Cloud Translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Generative AI / LLM (Google Gen AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
