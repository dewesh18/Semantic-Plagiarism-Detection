# PlagiarismAI Environment Configuration
# Copy this file to .env and supply your API keys.

# Web Search Providers (Optional: Tavily or Brave for live web crawling)
TAVILY_API_KEY=""
BRAVE_API_KEY=""

# Cloud AI Translation API (CO3 - Google Cloud Translation)
GOOGLE_TRANSLATE_API_KEY=""

# Generative AI / LLM (CO4 - Google Gemini API)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
